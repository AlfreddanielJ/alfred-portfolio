# Local:  copy to .env.local and fill in.
# Vercel: add the same names under Project > Settings > Environment Variables
#         (tick Production and Preview), then redeploy.
# Never prefix these with VITE_: that would publish them to every visitor's browser.

# From https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# With Resend's default sender this must be the email your Resend account was registered with.
CONTACT_TO_EMAIL=you@example.com

# Optional. Leave unset to use Resend's default sender, onboarding@resend.dev.
# CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
